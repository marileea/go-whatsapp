# Telegram Authentication Service Configuration

# Server Configuration
PORT=8080
ENV=development
SHUTDOWN_TIME=30s

# Telegram Bot Configuration
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Deep Link Configuration
# Base URL for generating deep links (e.g., your frontend app URL)
DEEPLINK_BASE_URL=https://yourapp.example.com/auth

# JWT Configuration
# Generate a secure secret (e.g., using: openssl rand -base64 32)
JWT_SECRET=your_jwt_secret_here
TOKEN_TTL=24h
REFRESH_TOKEN_TTL=168h
REFRESH_RATIO=3

# Database Configuration
# MySQL DSN (Data Source Name)
# Format: username:password@tcp(host:port)/database_name
MYSQL_DSN=username:password@tcp(mysql:3306)/telegram_auth

# Logging Configuration
LOG_LEVEL=info

# Webhook Configuration
# Optional: URL for webhook endpoints
WEBHOOK_URL=https://yourapp.example.com/webhook
WEBHOOK_SECRET=your_webhook_secret
WEBHOOK_TIMEOUT=30s